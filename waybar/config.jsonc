{
    "layer": "top",
    "position": "top",
    "height": 26,
    "spacing": 0,
    
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["mpris", "network", "bluetooth", "pulseaudio", "battery"],

    "hyprland/workspaces": {
        "format": "{name}",
        "disable-scroll": true,
        "all-outputs": true
    },
    
    "clock": {
        "interval": 1,
        "format": "{:%H:%M:%S | %d-%m-%Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "tooltip": true
    },

    "mpris": {
        "format": "{title}",
        "format-paused": "{title}",
        "max-length": 25,
        "tooltip": true,
        "tooltip-format": "{artist} - {title}",
		"ignored-players": ["vlc", "mpv"],
		"on-scroll-up": "playerctl volume 0.05+",
        "on-scroll-down": "playerctl volume 0.05-"
    },

    "network": {
        "format-wifi": "[NET: {essid}]",
        "format-ethernet": "[NET: ETH]",
        "format-disconnected": "[NET: DOWN]",
        "tooltip": false,
        "on-click": "pkill nm-connection-editor; nm-connection-editor"
    },

    "bluetooth": {
        "format": "[BT: ON]",
        "format-disabled": "[BT: OFF]",
        "format-connected": "[BT: {device_alias}]",
        "tooltip": false,
        "on-click": "pkill blueman-manager; blueman-manager"
    },
    
    "pulseaudio": {
        "format": "[VOL {volume}%]",
        "format-muted": "[MUTED]",
        "tooltip": false,
        "on-click": "pkill pavucontrol; pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "[BAT {capacity}%]"
    }
}
