{
    "layer": "top",
    "position": "top",
    "height": 26,
    "spacing": 0,
    
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["mpris", "network", "bluetooth", "pulseaudio", "battery"],

    "hyprland/workspaces": {
        "format": "{name}",
        "disable-scroll": true,
        "all-outputs": true
    },
    
    "clock": {
        "interval": 1,
        "format": "{:%H:%M:%S | %d-%m-%Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "tooltip": true,
        "calendar": {
            "iso8601": true,
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ffffff'><b>{}</b></span>",
                "days": "<span color='#ffffff'>{}</span>",
                "weeks": "<span color='#888888'>W{}</span>",
                "weekdays": "<span color='#ffffff'><b>{}</b></span>",
                "today": "<span color='#ffffff'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "mpris": {
        "format": "{title}",
        "format-paused": "{title}",
        "max-length": 25,
        "tooltip": true,
        "tooltip-format": "{artist} - {title}",
		"ignored-players": ["vlc", "mpv"]
    },

    "network": {
        "format-wifi": "[NET: {essid}]",
        "format-ethernet": "[NET: ETH]",
        "format-disconnected": "[NET: DOWN]",
        "tooltip": false,
        "on-click": "kitty --class nmtui -e nmtui"
    },

    "bluetooth": {
        "format": "[BT: ON]",
        "format-disabled": "[BT: OFF]",
        "format-connected": "[BT: {device_alias}]",
        "tooltip": false,
        "on-click": "pkill blueman-manager; blueman-manager"
    },
    
    "pulseaudio": {
        "format": "[VOL {volume}%]",
        "format-muted": "[MUTED]",
        "tooltip": false,
        "on-click": "pkill pavucontrol; pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "[BAT {capacity}%]"
    }
}
