{
    "layer": "top",
    "position": "top",
    "height": 26,
    "spacing": 0,
    
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["mpris", "tray", "custom/separator", "network", "bluetooth", "custom/separator", "disk", "cpu", "memory", "pulseaudio", "custom/separator", "backlight", "battery", "custom/separator", "custom/power"],

    "hyprland/workspaces": {
        "format": "{name}",
        "disable-scroll": true,
        "all-outputs": true
    },
    
    "clock": {
        "interval": 1,
        "format": "{:%H:%M:%S | %d-%m-%Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "tooltip": true,
        "calendar": {
            "iso8601": true,
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ffffff'><b>{}</b></span>",
                "days": "<span color='#ffffff'>{}</span>",
                "weeks": "<span color='#888888'>W{}</span>",
                "weekdays": "<span color='#ffffff'><b>{}</b></span>",
                "today": "<span color='#ffffff'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "mpris": {
        "format": "{title}",
        "format-paused": "{title}",
        "max-length": 25,
        "tooltip": true,
        "tooltip-format": "{artist} - {title}",
		"ignored-players": ["vlc", "mpv"]
    },

    "tray": {
        "icon-size": 14,
        "spacing": 8
    },

    "custom/separator": {
        "format": "|",
        "interval": "once",
        "tooltip": false
    },

    "network": {
        "interface": ["enp.*", "eth.*", "wlan.*", "wlp.*"],
        "format-ethernet": "󰈀 up",
        "format-wifi": "󰤨 {essid}",
        "format-unknown": "󰈂 up",
        "format-disconnected": "󰤭 down",
        "on-click": "kitty --class nmtui -e nmtui",
        "tooltip": false
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "tooltip": true,
        "tooltip-format": "",
        "tooltip-format-disabled": "",
        "tooltip-format-connected": "{device_alias}",
        "on-click": "blueman-manager"
    },
    
    "disk": {
        "interval": 30,
        "path": "/",
        "format": "󰋊 {percentage_used}%",
        "tooltip": true,
        "tooltip-format": "Disk: {used} / {total} ({percentage_used}%)"
    },

    "cpu": {
        "interval": 2,
        "format": " {usage}%",
        "tooltip": true
    },

    "memory": {
        "interval": 2,
        "format": " {percentage}%",
        "tooltip": true,
        "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 {volume}%",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "tooltip": false,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "tooltip": false,
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "~/.config/rofi/powermenu.sh"
    }
}
